# Anthropic API key powers the live qualifier at /api/qualify.
# Get one at https://console.anthropic.com/ and set it in Vercel → Project → Settings → Environment Variables.
# Never commit the real key. It stays server-side only.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override the model used by the qualifier.
# ANTHROPIC_QUALIFIER_MODEL=claude-sonnet-4-6

# Optional: your booking link (Cal.com / Calendly). Used by the CTA buttons.
# NEXT_PUBLIC_BOOKING_URL=https://cal.com/menteai/15min
